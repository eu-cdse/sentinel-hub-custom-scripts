{{- $scripts := slice -}}

{{- range where .Site.RegularPages "Section" "eq" "script" -}}
	{{- $taxonomies := dict
	 	"type" ( .Param "types" | jsonify )
	  	"verification" ( .Param "verifications" | jsonify )
	  	"default" ( .Param "default" | jsonify )
	  	"domain" ( .Param "domains" | jsonify )
	  	"data-source" ( .Param "data-sources" | jsonify )
	  	"resolution" ( .Param "resolutions" | jsonify )
	-}}
	{{- $script := dict
	    "url" .Permalink
	    "title" ( .Title | jsonify )
	    "content" ( .Content | plainify | jsonify )
	}}
	    {{/* "summary"{{ with .Description }}{{ . | plainify | jsonify }}{{ else }}{{ .Summary | plainify | jsonify }}{{ end }}, */}}
	{{- $scripts = $scripts | append $script -}}
{{- end -}}

{{- $object := dict "blog" $scripts -}}
{{- $jsonifyOptions := dict "indent" "    " -}}
{{- $object | jsonify $jsonifyOptions -}}
