{{- $list := slice -}}

{{- range where .Site.RegularPages "Section" "eq" "script" -}}
    {{- $page := . -}}
    {{- $taxonomies := dict -}}
    {{- range $taxonomy, $_ := site.Taxonomies -}}
        {{- $terms := slice -}}
        {{- range $page.GetTerms $taxonomy -}}
            {{- $terms = $terms | append .Data.Term -}}
        {{- end -}}
        {{- $taxonomies = merge $taxonomies (dict $taxonomy $terms) -}}
    {{- end -}}
    {{- $script := dict
        "url" .Permalink
        "title" .Title
        "content" ( .Content | plainify )
        "taxonomies" $taxonomies
    -}}
    {{- $list = $list | append $script -}}
{{- end -}}

{{- $object := dict "scripts" $list -}}
{{- $jsonifyOptions := dict "indent" "    " -}}
{{- $object | jsonify $jsonifyOptions -}}
