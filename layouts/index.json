{{- $scripts := slice -}}

{{- range where .Site.RegularPages "Section" "eq" "script" -}}
	{{- $taxonomies := dict
	 	"type" ( .Param "types" )
	  	"verification" ( .Param "verifications"  )
	  	"default" ( .Param "default"  )
	  	"domain" ( .Param "domains"  )
	  	"data-source" ( .Param "data-sources"  )
	  	"resolution" ( .Param "resolutions"  )
	-}}
	{{- $script := dict
	    "url" .Permalink
	    "title" .Title
	    "content" ( .Content | plainify )
		"taxonomies" $taxonomies
	}}
	{{- $scripts = $scripts | append $script -}}
{{- end -}}

{{- $object := dict "blog" $scripts -}}
{{- $jsonifyOptions := dict "indent" "    " -}}
{{- $object | jsonify $jsonifyOptions -}}
