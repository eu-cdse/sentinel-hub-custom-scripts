{
    "loadcollection": {
        "process_id": "load_collection",
        "arguments": {
            "id": "sentinel-2-l2a",
            "spatial_extent": {},
            "temporal_extent": null,
            "bands": ["B03", "B08"],
            "upsampling": "NEAREST",
            "downsampling": "BILINEAR"
        }
    },
    "save": {
        "process_id": "save_result",
        "arguments": {
            "data": {
                "from_node": "colorRamp"
            },
            "format": "webp"
        },
        "result": true
    },
    "index": {
        "process_id": "ndvi",
        "arguments": {
            "data": {
                "from_node": "loadcollection"
            },
            "target_band": "NDVI",
            "nir": "B03",
            "red": "B08"
        }
    },
    "colorRamp": {
        "process_id": "color_ramp",
        "arguments": {
            "data": {
                "from_node": "index"
            },
            "minValue": -1,
            "maxValue": 1,
            "colorRamps": [
                [-0.8, "0x008000"],
                [0, "0xFFFFFF"],
                [0.8, "0x0000CC"]
            ]
        }
    }
}
